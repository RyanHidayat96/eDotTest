# Local secrets and deployment-specific runtime values only. Static test data,
# repository paths, and eWork UI locators are versioned with the source code.

# eSuite web
ESUITE_BASE_URL=https://esuite.edot.id
ESUITE_EMAIL=
ESUITE_PASSWORD=
HEADLESS=true
SLOW_MO_MS=0
BROWSER=chromium

# Allure evidence privacy. Enable only for a local development report.
ALLURE_SHOW_DEV_INPUTS=false

# Optional Gemini-backed test data
GEMINI_API_KEY=
GEMINI_TEST_DATA_MODEL=gemini-3.1-flash-lite

# Local Android / Maestro runtime
MAESTRO_CLI=maestro
ADB_COMMAND=adb
MOBILE_DEVICE_ID=
MOBILE_FLOW_TIMEOUT_SECONDS=300
EDOT_LIVE=false
EWORK_APP_ID=id.edot.ework
EWORK_EMAIL=
EWORK_PASSWORD=
EWORK_COMPANY_CODE=
