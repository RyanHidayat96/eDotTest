# Local secrets and deployment-specific runtime values only. Static test data,
# repository paths, and eWork UI locators are versioned with the source code.

# eSuite web
ESUITE_BASE_URL=https://esuite.edot.id # Target eSuite web URL.
ESUITE_EMAIL=                         # Local eSuite login email; leave blank in repository.
ESUITE_PASSWORD=                      # Local eSuite login password; leave blank in repository.
HEADLESS=true                         # true for headless browser, false for visible browser.
SLOW_MO_MS=0                          # Optional Playwright slow motion in milliseconds.
BROWSER=chromium                      # Playwright browser engine: chromium, firefox, or webkit.

# Allure evidence privacy. Enable only for a local development report.
ALLURE_SHOW_DEV_INPUTS=false          # true shows raw input values in local Allure evidence.

# Optional Gemini-backed test data
GEMINI_API_KEY=                       # Optional Gemini API key; blank uses deterministic fallback.
GEMINI_TEST_DATA_MODEL=gemini-3.1-flash-lite # Gemini model for company test data generation.

# Local Android / Maestro runtime
MAESTRO_CLI=maestro                   # Maestro executable path or command name.
ADB_COMMAND=adb                       # ADB executable path or command name.
MOBILE_DEVICE_ID=                     # Optional Android device serial when more than one device is connected.
MOBILE_FLOW_TIMEOUT_SECONDS=300       # Max runtime for one Maestro flow.
EDOT_LIVE=false                       # true enables real mobile device tests; false skips them.
EWORK_APP_ID=id.edot.ework            # Android package id for eWork.
EWORK_EMAIL=                          # Local eWork username/email for mobile login tests.
EWORK_PASSWORD=                       # Local eWork password; leave blank in repository.
EWORK_COMPANY_CODE=                   # Local eWork company code for mobile login tests.
