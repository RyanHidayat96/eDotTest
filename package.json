{
  "name": "edot-qa-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Local Allure commandline tooling for the eDOT QA automation take-home project.",
  "scripts": {
    "test": "npm run test:all",
    "test:all": ".venv\\Scripts\\python.exe -m pytest tests",
    "test:quick": ".venv\\Scripts\\python.exe -m pytest tests/ai tests/web/test_web_quality_gates.py tests/web/test_foundation.py tests/web/test_company_registration_data.py tests/mobile/test_mobile_foundation.py -q",
    "test:ai": ".venv\\Scripts\\python.exe -m pytest tests/ai -q",
    "test:web": ".venv\\Scripts\\python.exe -m pytest tests/web -q",
    "test:web:quality": ".venv\\Scripts\\python.exe -m pytest tests/web/test_web_quality_gates.py -q",
    "test:web:login": ".venv\\Scripts\\python.exe -m pytest tests/web/test_login.py -q",
    "test:web:company:step1": ".venv\\Scripts\\python.exe -m pytest tests/web/test_create_company.py::test_register_company_step_one_requires_valid_data -q",
    "test:web:company:full": ".venv\\Scripts\\python.exe -m pytest tests/web/test_create_company.py::test_create_company_three_step_wizard_with_ai_data -q",
    "test:web:company:full:debug": "set E2E_CONSOLE_STEPS=true&& .venv\\Scripts\\python.exe -m pytest tests/web/test_create_company.py::test_create_company_three_step_wizard_with_ai_data -q -s",
    "test:mobile": ".venv\\Scripts\\python.exe -m pytest tests/mobile -q -rs",
    "test:mobile:foundation": ".venv\\Scripts\\python.exe -m pytest tests/mobile/test_mobile_foundation.py -q -rs",
    "test:mobile:login": ".venv\\Scripts\\python.exe -m pytest tests/mobile/test_mobile_login.py -q -rs",
    "test:mobile:customer": ".venv\\Scripts\\python.exe -m pytest tests/mobile/test_mobile_create_customer.py -q -rs",
    "triage": ".venv\\Scripts\\python.exe tools/triage_allure_failures.py --results-dir reports/allure-results --output reports/triage/triage-report.md",
    "triage:no-ai": ".venv\\Scripts\\python.exe tools/triage_allure_failures.py --results-dir reports/allure-results --output reports/triage/triage-report.md --no-ai",
    "allure:clean": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item -Recurse -Force 'reports/allure-results','reports/allure-results-mobile-live','reports/allure-report','reports/allure-report-mobile' -ErrorAction SilentlyContinue\"",
    "allure:generate": ".venv\\Scripts\\python.exe tools/generate_allure_report.py --results-dir reports/allure-results --report-dir reports/allure-report",
    "allure:generate:mobile": ".venv\\Scripts\\python.exe tools/generate_allure_report.py --results-dir reports/allure-results-mobile-live --report-dir reports/allure-report-mobile",
    "allure:open": ".venv\\Scripts\\python.exe tools/generate_allure_report.py --results-dir reports/allure-results --report-dir reports/allure-report --open",
    "allure:open:mobile": ".venv\\Scripts\\python.exe tools/generate_allure_report.py --results-dir reports/allure-results-mobile-live --report-dir reports/allure-report-mobile --open"
  },
  "devDependencies": {
    "allure-commandline": "^2.43.0"
  }
}
