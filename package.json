{
  "name": "edot-qa-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Convenience scripts for the eDOT QA automation take-home project.",
  "scripts": {
    "test:web": ".venv\\Scripts\\python.exe -m pytest tests/web/test_login.py::test_esuite_login_shows_dashboard_greeting tests/web/test_create_company.py::test_create_company_three_step_wizard_with_ai_data -q",
    "test:web:login": ".venv\\Scripts\\python.exe -m pytest tests/web/test_login.py::test_esuite_login_shows_dashboard_greeting -q",
    "test:web:deliberate": ".venv\\Scripts\\python.exe -m pytest tests/web/test_login.py::test_web_login_wrong_button_locator_records_real_failure -q",
    "test:web:company": ".venv\\Scripts\\python.exe -m pytest tests/web/test_create_company.py -q",
    "test:mobile": ".venv\\Scripts\\python.exe -m pytest tests/mobile/test_mobile_login.py::test_ework_login_displays_dashboard tests/mobile/test_mobile_create_customer.py::test_ework_create_customer_appears_with_correct_data -q -rs",
    "test:mobile:login": ".venv\\Scripts\\python.exe -m pytest tests/mobile/test_mobile_login.py::test_ework_login_displays_dashboard -q -rs",
    "test:mobile:deliberate": ".venv\\Scripts\\python.exe -m pytest tests/mobile/test_mobile_login.py::test_mobile_login_wrong_password_locator_records_real_failure -q -rs",
    "test:mobile:customer": ".venv\\Scripts\\python.exe -m pytest tests/mobile/test_mobile_create_customer.py::test_ework_create_customer_appears_with_correct_data -q -rs",
    "test:ai": ".venv\\Scripts\\python.exe -m pytest tests/ai -q",
    "test:handoff": ".venv\\Scripts\\python.exe -m pytest tests/web/test_web_mobile_handoff.py::test_web_created_company_handoff_drives_mobile_login -q -rs",
    "triage": ".venv\\Scripts\\python.exe tools/triage_allure_failures.py --results-dir reports/allure-results --output reports/triage/triage-report.md",
    "allure:generate": ".venv\\Scripts\\python.exe tools/generate_allure_report.py --open"
  },
  "devDependencies": {
    "allure-commandline": "^2.43.0"
  }
}
